          { "node": "One flag at a time", "type": "main", "index": 0 }
        ]
      ]
    },
    "One flag at a time": {
      "main": [
        [
          { "node": "Check last 7 days of traffic (MCP)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check last 7 days of traffic (MCP)": {
      "main": [
        [
          { "node": "Still getting traffic?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Still getting traffic?": {
      "main": [
        [
          { "node": "Flag the flag", "type": "main", "index": 0 }
        ],
        []
      ]
    }
  },
