{
	"name": "@unleash/n8n-nodes-unleash",
	"version": "0.0.0",
	"description": "n8n community node that evaluates Unleash feature flags through the Frontend API",
	"license": "MIT",
	"homepage": "https://github.com/Unleash/n8n-nodes-unleash#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"unleash",
		"feature-flags",
		"feature-toggles"
	],
	"author": {
		"name": "Unleash",
		"email": "team@getunleash.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Unleash/n8n-nodes-unleash.git"
	},
	"bugs": {
		"url": "https://github.com/Unleash/n8n-nodes-unleash/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/**/*.test.mjs\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/UnleashFrontendApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Unleash/Unleash.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.3",
		"n8n-workflow": "~2.47.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"unleash-proxy-client": "3.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
